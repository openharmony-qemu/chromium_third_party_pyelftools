<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="Public Domain" path=".*" desc="" />
                <policyitem type="compatibility" name="Unknown License file reference" path="test.*" desc="" />

            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="README.rst"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*elf"
                    desc="" />
                <filteritem type="filepath" name="test/testfiles_for_readelf/clang33-simple.o"
                    desc="" />
                <filteritem type="filepath" name="test/testfiles_for_readelf/gcc48-simple.o"
                    desc="" />
                <filteritem type="filepath" name="test/testfiles_for_unittests/simple_gcc.elf.arm"
                    desc="" />
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Public Domain" desc="">
                <licensetext name="
                Name: pyelftools
                Short Name: pyelftools
                URL: https://bitbucket.org/eliben/pyelftools
                Version: 0
                Revision: d23cf2f5bd2a3c3d6f516f0f2d01817ea83236fc
                License: Public Domain
                License File: LICENSE
                Security Critical: no
            " desc="" />
            </licensematcher>
            <licensematcher name="Public Domain" desc="">
                <licensetext name="
                # Eli Bendersky (eliben@gmail.com)
                # This code is in the public domain
            " desc="" />
            </licensematcher>
             <licensematcher name="Public Domain" desc="">
                <licensetext name="
                # pyelftools: setup.py
                #
                # Setup/installation script.
                #
                # Eli Bendersky (eliben@gmail.com)
                # This code is in the public domain
            " desc="" />
            </licensematcher>
            <licensematcher name="Unknown License file reference" desc="">
                <licensetext name="
                ** http://knol.google.com/k/roberto-garca-lpez/creating-elf-relocatable-object-files/1ohwel4gqkcn2/3#
                **
                ** Note: This file is released under the terms of the LGPL2 license.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>